{
  "name": "skill-icons",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "icons": "bun scripts/build-icons.ts",
    "skill-icon": "bun scripts/skill-icon.ts",
    "manager": "sh tools/icon-manager/dmg.sh --open",
    "manager:build": "sh tools/icon-manager/build.sh",
    "manager:dmg": "sh tools/icon-manager/dmg.sh",
    "dev": "bun run icons && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
    "build": "bun run icons && tsc -b && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "preview": "bun run build && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite preview",
    "deploy": "bun run build && wrangler deploy",
    "build:lib": "bun run --cwd packages/skill-icons build",
    "test:lib": "bun run --cwd packages/skill-icons test",
    "typecheck:lib": "bun run --cwd packages/skill-icons typecheck",
    "pack:lib": "bun run build:lib && cd packages/skill-icons && npm pack --dry-run --ignore-scripts",
    "test": "bun run icons && vitest run",
    "typecheck": "bun run icons && tsc -b",
    "og": "python3 .claude/skills/skill-icons-og/scripts/render_og.py site --icons-dir icons --out public/og-site.png && python3 .claude/skills/skill-icons-og/scripts/render_og.py site --icons-dir icons --bg dark --out public/og-site-dark.png",
    "cf-typegen": "wrangler types",
    "format": "biome format --write .",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/runner": "^4.1",
    "@vitest/snapshot": "^4.1",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1",
    "wrangler": "^4.147.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
