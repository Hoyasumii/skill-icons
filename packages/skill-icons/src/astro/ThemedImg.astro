---
import { LIGHT_MEDIA } from '../core/index.js';
import type { ImgProps } from './types.js';

interface Props extends ImgProps {
  /** Dark (or only) source first, then the light one for 'auto'. */
  sources: string[];
  width?: number;
  height?: number;
}

const { sources, ...img } = Astro.props;
const [src, lightSrc] = sources;
---
{
  !lightSrc || lightSrc === src ? (
    <img {...img} src={src} />
  ) : (
    <picture>
      <source media={LIGHT_MEDIA} srcset={lightSrc} />
      <img {...img} src={src} />
    </picture>
  )
}
