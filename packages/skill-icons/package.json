{
  "name": "@hoyasumii/skill-icons",
  "version": "0.1.0",
  "description": "Skill icons as components for React, Vue, Angular and more.",
  "keywords": [
    "skill-icons",
    "icons",
    "svg",
    "react",
    "vue",
    "svelte",
    "angular",
    "solid",
    "astro",
    "web-components"
  ],
  "author": "Alan Reis",
  "homepage": "https://skill-icons.alanreisanjo.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoyasumii/skill-icons.git",
    "directory": "packages/skill-icons"
  },
  "bugs": {
    "url": "https://github.com/Hoyasumii/skill-icons/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element/define.js"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx",
      "node": "./dist/solid/server.js",
      "default": "./dist/solid/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./element/define": {
      "types": "./dist/element/define.d.ts",
      "default": "./dist/element/define.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "scripts": {
    "icons": "bun ../../scripts/build-icons.ts",
    "build": "bun run icons && rm -rf dist && tsc -p tsconfig.json && ngc -p tsconfig.angular.json && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json && tsc -p tsconfig.astro-build.json && cp src/astro/*.astro dist/astro/ && tsc -p tsconfig.solid.build.json && node solid.build.mjs",
    "typecheck": "bun run icons && tsc -p tsconfig.test.json && vue-tsc -p tsconfig.vue.json && ngc -p tsconfig.angular.json --noEmit && svelte-check --tsconfig tsconfig.svelte.json --fail-on-warnings && astro check --tsconfig tsconfig.astro.json && tsc -p tsconfig.solid.json",
    "test": "bun run icons && vitest run",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "astro": ">=4",
    "@angular/core": ">=17.1",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^21",
    "@angular/compiler": "^21",
    "@angular/compiler-cli": "^21",
    "@angular/core": "^21",
    "@angular/platform-browser": "^21",
    "@angular/platform-server": "^21",
    "@astrojs/check": "^0.9.10",
    "@babel/core": "^7",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "babel-preset-solid": "^1.9.15",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "~5.9",
    "vite-plugin-solid": "^2.11.14",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12",
    "zone.js": "^0.16.3"
  }
}
