{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-icons",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    // Pages are real files (index.html, mcp.html, pt-BR/…); any other path gets 404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only these routes hit the Worker; everything else is served as a static asset.
    // "/" and "/mcp" do so to send visitors to the page in their language (/pt-BR/…);
    // every page does so that "?bg=dark" can swap in the dark link preview card.
    "run_worker_first": [
      "/",
      "/icons",
      "/icons/",
      "/og",
      "/og/",
      "/mcp",
      "/mcp/",
      "/pt-BR",
      "/pt-BR/",
      "/pt-BR/mcp",
      "/pt-BR/mcp/",
      "/api/*"
    ]
  }
}
