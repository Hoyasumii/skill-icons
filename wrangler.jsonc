{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-icons",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these routes hit the Worker; everything else is served as a static asset.
    "run_worker_first": [
      "/",
      "/icons",
      "/icons/",
      "/og",
      "/og/",
      "/mcp",
      "/mcp/",
      "/api/*",
    ],
  },
}
